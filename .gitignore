# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Geospatial / large outputs (uncomment if not tracking in git)
# transformation/*/release/*/output/*.geojson
# transformation/*/release/*/arquivo-gtfs/

# Score transformation runtime site data (caches, inputs, published packages)
transformation/*/sites/*/cache/
transformation/*/sites/*/data/
transformation/*/sites/*/out/
transformation/*/sites/*/intermediate/

# NbS screening runtime outputs
transformation/nbs_screening/output/*
!transformation/nbs_screening/output/.gitkeep

# Keep small city boundaries trackable when added:
# transformation/*/sites/*/boundary/*.geojson

# Raster tiles (generated by gdal2tiles.py)
**/tiles*/
**/tiles_*_values/

# GeoTIFF outputs
*.tif
*.gpkg
